{
  "collectionName": "components_admin_inquiries",
  "info": {
    "displayName": "Inquiry",
    "icon": "mail",
    "description": "User contact inquiries and messages"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "New",
        "Read",
        "Responded"
      ],
      "default": "New"
    },
    "createdAt": {
      "type": "datetime"
    }
  }
}
